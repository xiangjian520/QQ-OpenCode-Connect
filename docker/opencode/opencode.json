{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "agent": {
    "qq-chat": {
      "description": "Safe QQ chat assistant with file and shell tools disabled",
      "mode": "primary",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "read": false,
        "grep": false,
        "glob": false,
        "list": false,
        "task": false,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "websearch": false
      }
    },
    "qq-code": {
      "description": "Administrator-only coding agent for the isolated QQ bot workspace",
      "mode": "primary"
    }
  }
}
