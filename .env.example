# Web console
WEB_PORT=8080
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-me-now

# OpenCode (docker or external)
OPENCODE_MODE=docker
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-this-opencode-password
OPENCODE_WORKSPACE=./agent-workspace
OPENCODE_MODEL_VARIANT=none

# OneBot v11 / NapCat
ONEBOT_TOKEN=change-this-onebot-token
ONEBOT_REQUIRE_MENTION=true
ONEBOT_ALLOWED_PRIVATE_IDS=
ONEBOT_ALLOWED_GROUP_IDS=
BOT_ADMIN_QQ_IDS=

# MySQL
MYSQL_MODE=docker
DB_URL='jdbc:mysql://127.0.0.1:3307/qqbot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
DB_USERNAME=qqbot
DB_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3307

# Behaviour
QQBOT_QUEUE_MAX=5
QQBOT_REPLY_CHUNK_SIZE=1800
QQBOT_REPLY_DELAY_MS=250
QQBOT_RETENTION_DAYS=90
QQBOT_OPENCODE_TIMEOUT_SECONDS=300
